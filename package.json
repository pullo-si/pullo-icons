{
  "name": "pullo-icons",
  "version": "0.1.0",
  "description": "Extra icons in the style of Phosphor Icons, for the icons Phosphor doesn't have. Iconify JSON and plain SVG, six weights.",
  "license": "MIT",
  "author": "Andrej Rus",
  "homepage": "https://github.com/pullo-si/pullo-icons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pullo-si/pullo-icons.git"
  },
  "bugs": {
    "url": "https://github.com/pullo-si/pullo-icons/issues"
  },
  "type": "module",
  "keywords": [
    "icons",
    "svg",
    "iconify",
    "phosphor",
    "phosphor-icons",
    "icon-set",
    "ui"
  ],
  "files": [
    "icons.json",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./icons.json": "./icons.json",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "iconSet": {
    "icons": "icons.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/preview.mjs",
    "compare": "node scripts/compare.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@iconify-json/ph": "1.2.2",
    "@iconify/utils": "3.1.7",
    "pathkit-wasm": "1.0.0",
    "playwright-core": "1.64.1"
  }
}
